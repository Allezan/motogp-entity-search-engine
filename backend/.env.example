# Copy this file to backend/.env and fill in your Neon PostgreSQL credentials.
# Option 1 (Recommended): Single Neon connection string
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual PostgreSQL parameters
PGHOST=
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_API_KEY=

# Retrieval defaults (aligned with Notebook v5 & AGENT.md)
DEFAULT_ALPHA=0.8
DEFAULT_BETA=0.2
USE_STORED_PROCESSED_TEXT=true
USE_STORED_DOCUMENT_ENTITIES=true
